{
  "name": "trading-bot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["server"],
  "scripts": {
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "vite --port 5173",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm --workspace=server run build && tsc && vite build",
    "build:server": "npm --workspace=server run build",
    "build:client": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
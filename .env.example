# Copy to .env and server/.env
GEMINI_API_KEY=your_gemini_api_key_from_aistudio.google.com
GEMINI_MODEL=gemini-2.0-flash
# fallback if 2.0 fails: gemini-1.5-flash-latest
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
CRON_SECRET=random_32_char_string_for_github_actions
ADMIN_USER=admin
ADMIN_PASS=your_strong_password
PORT=3001
VITE_API_URL=http://localhost:3001
# Opsional mitigasi >1 bulan - isi jika rate limit / mau private endpoints
BINANCE_API_KEY=
BINANCE_API_SECRET=

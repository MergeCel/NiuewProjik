# Copy to .env and server/.env
GEMINI_API_KEY=changeme
GEMINI_MODEL=gemini-3.5-flash-lite
# fallback otomatis: gemini-3.5-flash, gemini-3-flash-preview
# NO_TRADE_COOLDOWN_MIN=60  # menit skip Gemini setelah NO_TRADE (hemat kuota harian)
# COOLDOWN_OVERRIDE_ATR=0.5  # override breakout: panggil Gemini jika harga bergerak >0.5xATR(1H)
# COOLDOWN_OVERRIDE_ATR_HYST=0.7  # setelah override, threshold naik (hysteresis anti-whipsaw)
# OVERRIDE_CAP_PER_HOUR=3  # max override per jam per pair (anti-choppy)
SUPABASE_URL=test
SUPABASE_SERVICE_ROLE_KEY=test
SUPABASE_ANON_KEY=tet
SUPABASE_PASS=test
CRON_SECRET=test
ADMIN_USER=admin
ADMIN_PASS=changeme
PORT=3001
VITE_API_URL=http://localhost:3001
# Opsional mitigasi >1 bulan - isi jika rate limit / mau private endpoints
BINANCE_API_KEY=
BINANCE_API_SECRET=
